# local | hunyuan | tripo
# Use GENERATION_PROVIDER=local only for testing the viewer with the fake cube backend.
GENERATION_PROVIDER=local

# Used when GENERATION_PROVIDER=local or hunyuan
HUNYUAN_BACKEND_URL=http://127.0.0.1:8000

# If you are not intentionally testing the placeholder cube, leave GENERATION_PROVIDER unset
# and set one of the real backends below instead.

# Public URL the GPU host returns in modelUrl (set this on the GPU machine)
# HUNYUAN_PUBLIC_BASE_URL=https://your-gpu-host.example.com

# Used when GENERATION_PROVIDER=tripo
# TRIPO_API_KEY=tsk_...
# TRIPO_MODEL_VERSION=v2.5-20250123
